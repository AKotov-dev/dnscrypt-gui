[NAME]
name=dnscrypt-gui

[VERSION]
version=1.6

[RELEASE]
release=0.mrx10

[GROUP]
group=Networking/Other

[DESCRIPTION]
0=DNSCrypt proxy 2 and GUI (self-contained package)
1=...
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=DNSCrypt proxy 2 and GUI (self-contained package)

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/dnscrypt-gui

[LICENSE]
license=GPLv3

[DEPS]
deps=systemd libcap2-bin libgtk2.0-0

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/bin/dnscrypt-gui
1=/usr/share/icons/dnscrypt-gui.png
2=/etc/systemd/user/dnscrypt-proxy.service
3=/usr/share/applications/dnscrypt-gui.desktop
4=/opt/dnscrypt-gui/
5=/usr/share/doc/dnscrypt-gui/

[AFTERINSTALL]
0=#!/bin/bash
1=systemctl daemon-reload >/dev/null 2>&1 || :
2=
3=BINARY=/opt/dnscrypt-gui/dnscrypt-proxy
4=
5=if [ -f "$BINARY" ]; then
6=# Снимаем старые capabilities на всякий случай
7=setcap -r "$BINARY" 2>/dev/null || :
8=
9=# Навешиваем нужный capability
10=setcap 'cap_net_bind_service=+ep' "$BINARY" 2>/dev/null || :
11=
12=# Проверка
13=CAP_SET=$(getcap "$BINARY")
14=if [ -z "$CAP_SET" ]; then
15=echo "Warning: failed to set capabilities on $BINARY"
16=fi
17=fi

[AFTERREMOVE]
0=#!/bin/bash
1=systemctl daemon-reload >/dev/null 2>&1 || :
2=# Не снимаем capabilities — чтобы апгрейд нового пакета не ломал их

[BEFOREINSTALL]
0=#!/bin/bash
1=# Обновляем конфигурацию systemd для чистоты
2=systemctl daemon-reload >/dev/null 2>&1 || :

[BEFOREREMOVE]
0=#!/bin/bash
1=if [ $1 -eq 0 ]; then
2=# Только при полном удалении
3=systemctl disable dnscrypt-proxy.service >/dev/null 2>&1 || :
4=fi

[URL32]
url32=https://github.com/AKotov-dev/dnscrypt-gui

[PROGRAMNAME]
programname=DNSCrypt-GUI

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.6

[INFO]
0=v1.6
1=+ DNS Forwarding Rules Editor
2=+ Improved /etc/systemd/user/dnscrypt-proxy.service
3=+ Self-contained RPM and DEB packages
4=
5=**Note**
6=- After updating, click the "Restart" button to apply the DNS forwarding rules
7=- The `Default` template already contains selective rules for the Russia and is built into the program to serve as a fallback
8=- For other countries, you may want to consider using domain zones or creating your own custom list, following the same pattern
9=
10=v1.5
11=+ DNS Leak Test 2 has been added
12=+ Update [dnscrypt-proxy v2.1.21](https://github.com/DNSCrypt/dnscrypt-proxy/releases/tag/2.1.21)
13=+ Self-contained RPM and DEB packages
14=
15=**Note:** DNS Leak Test 2 is more aggressive than Test1 and can leak your IP unless WebRTC is disabled in your browser. Using a WebRTC blocker extension is recommended for better security.
16=
17=v1.4.2
18=+ Update [dnscrypt-proxy v2.1.20](https://github.com/DNSCrypt/dnscrypt-proxy/releases/tag/2.1.20)
19=+ Self-contained `RPM` and `DEB` packages
